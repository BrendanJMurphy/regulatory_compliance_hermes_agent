# Copy to .env, fill in, chmod 600. Never commit .env.

# ---- Model endpoint ----
# Production: a firm-hosted OpenAI-compatible endpoint inside the VPC (control DR-1).
# Development with the synthetic fixture data only: OpenRouter works unchanged, because it is
# OpenAI-compatible. Never point a real-data deployment at it.
COMPLIANCE_MODEL_BASE_URL=https://openrouter.ai/api/v1
COMPLIANCE_MODEL_API_KEY=sk-or-v1-paste-your-key-here
COMPLIANCE_MODEL=anthropic/claude-sonnet-5

# ---- Compliance MCP server ----
COMPLIANCE_MCP_URL=http://compliance-mcp:8765/mcp
COMPLIANCE_MCP_TOKEN=replace-with-32-random-bytes
COMPLIANCE_AGENT_ID=hermes-regcomply-prod
# Optional: stream every audit record to the SIEM / WORM archive
COMPLIANCE_AUDIT_FORWARD_URL=
COMPLIANCE_AUDIT_FORWARD_TOKEN=

# ---- Microsoft Teams (Azure Bot registration) ----
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=
# Comma-separated AAD object ids permitted to talk to the bot. Required.
TEAMS_ALLOWED_USERS=
TEAMS_PORT=3978
# Conversation id of the compliance channel; cron jobs with deliver=teams post here.
# Easiest: run /sethome from the bot inside the channel, then copy the value it prints.
TEAMS_HOME_CHANNEL=

# ---- Container user ----
HERMES_UID=10000
HERMES_GID=10000
