# Copy to .env, fill in, chmod 600. Never commit .env.
# In production every secret below is injected from the secrets manager at deploy time;
# this file exists so a developer can run the whole loop locally with synthetic data.

# ---- Model endpoint ----
# Production: a firm-hosted OpenAI-compatible endpoint inside the VPC (control DR-1).
# Development with the synthetic fixture data only: OpenRouter works unchanged.
COMPLIANCE_MODEL_BASE_URL=https://openrouter.ai/api/v1
COMPLIANCE_MODEL_API_KEY=sk-or-v1-paste-your-key-here
COMPLIANCE_MODEL=anthropic/claude-sonnet-5

# ---- Compliance MCP server ----
COMPLIANCE_MCP_URL=http://compliance-mcp:8765/mcp
# Shared secret between gateway and MCP server. scripts/bootstrap.sh generates one if left as-is.
COMPLIANCE_MCP_TOKEN=generate-me
COMPLIANCE_AGENT_ID=hermes-regcomply-dev
# Key for the audit-record MACs. Held only by the MCP server; generated by bootstrap if left as-is.
COMPLIANCE_AUDIT_HMAC_KEY=generate-me
# Identity: "parameter" lets the model supply requester (dev, synthetic data only).
# Production: "header", with an authenticating gateway setting X-Requester on every request.
COMPLIANCE_IDENTITY_MODE=parameter
# Review CLI identity: "dev" trusts --as; production "oidc" verifies --id-token.
COMPLIANCE_REVIEW_IDENTITY_MODE=dev
COMPLIANCE_OIDC_ISSUER=
COMPLIANCE_OIDC_AUDIENCE=
COMPLIANCE_OIDC_JWKS_URL=
# Per-requester call budget; a runaway loop is cut off within seconds.
COMPLIANCE_RATE_LIMIT_PER_MINUTE=120
# Lets scenario runs pin "today". Must be false in production.
COMPLIANCE_ALLOW_CLOCK_OVERRIDE=true
# Optional: stream every audit record and periodic chain anchors to the SIEM / WORM archive.
COMPLIANCE_AUDIT_FORWARD_URL=
COMPLIANCE_AUDIT_FORWARD_TOKEN=

# ---- Microsoft Teams (Azure Bot registration) ----
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=
# Comma-separated AAD object ids permitted to talk to the bot. Required.
TEAMS_ALLOWED_USERS=
TEAMS_PORT=3978
TEAMS_BIND=127.0.0.1
# Conversation id of the compliance channel; cron jobs with deliver=teams post here.
TEAMS_HOME_CHANNEL=

# ---- Container user ----
HERMES_UID=10000
HERMES_GID=10000
